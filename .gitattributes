# Windows scripts MUST have CRLF line endings: cmd.exe mis-parses LF-only .bat files (goto/labels),
# and a GitHub "Download ZIP" gives files exactly as stored here.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.txt  text eol=crlf

# everything else: normalise to LF in the repo
*.py   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
